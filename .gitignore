# The wrapper jar must be committed, or `./gradlew` cannot bootstrap on a fresh
# clone. Patterns need a leading `**/` to match below the repository root, which
# is where `backend/gradle/wrapper/` lives.
!**/gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.properties
*.log
hs_err_pid*
replay_pid*


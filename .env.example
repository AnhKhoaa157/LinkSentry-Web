# LinkSentry — root example environment file.
#
# Copy to `.env` for local Docker Compose usage:
#   cp .env.example .env
#
# Every value below is a LOCAL-DEVELOPMENT-ONLY placeholder.
# None of these are production secrets and none of them may be reused in a
# deployed environment. Generate real credentials out-of-band and inject them
# through your platform's secret manager instead.

# ---------- PostgreSQL (consumed by compose.yaml) ----------
POSTGRES_DB=linksentry
POSTGRES_USER=linksentry
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432

# ---------- Backend ----------
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/linksentry
SPRING_DATASOURCE_USERNAME=linksentry
SPRING_DATASOURCE_PASSWORD=local-development-only
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- Frontend ----------
# Baked into the browser bundle when the frontend image is built, so it must be an
# origin the browser can reach on the host — not a Compose service name.
VITE_API_BASE_URL=http://localhost:8080

# Host port for the containerised frontend (`frontend` profile). Keep it aligned
# with CORS_ALLOWED_ORIGINS above: changing it means the browser origin changes.
FRONTEND_PORT=5173

# LinkSentry API — example environment file.
#
# Copy to `backend/.env` and load it through your IDE's run configuration, or
# export the variables in your shell. Spring Boot does not read `.env` files on
# its own.
#
# Every value here is a LOCAL-DEVELOPMENT-ONLY placeholder, not a production
# secret. Real credentials belong in a secret manager and must never be committed.

SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ---------- Database ----------
# Matches the defaults in the repository-root compose.yaml.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/linksentry
SPRING_DATASOURCE_USERNAME=linksentry
SPRING_DATASOURCE_PASSWORD=local-development-only

# ---------- CORS ----------
# Comma-separated exact origins. Never use a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- Device licensing ----------
# Default device cap for a license created without an explicit maxDevices value.
# The documented default is one web installation plus one extension installation.
LICENSE_DEFAULT_MAX_DEVICES=2
# How long a device installation (created by the public POST /api/v1/devices)
# is kept if it is never granted any license, bounding unbounded table growth
# from that unauthenticated endpoint. A device with any assignment history —
# even a later-revoked one — is never deleted regardless of age. Spring Boot
# Duration syntax, e.g. 30d, 12h.
LICENSE_PENDING_DEVICE_RETENTION=30d

# ---------- Administrator API ----------
# Backend-only credential for /api/v1/admin/**. Never expose this to the
# frontend or extension. Leaving it blank does not fail startup, but every
# admin request is then rejected — there is no configured value a presented
# key could ever match. Generate one long, random value per deployment, e.g.:
#   openssl rand -base64 32
# NEVER put a real key in this checked-in example file — set it only in a real
# untracked `backend/.env`, your IDE run configuration, or your secret manager.
ADMIN_API_KEY=

# ---------- Admin console authentication ----------
# Separate from ADMIN_API_KEY above: this is a human administrator's browser
# login for the protected /admin dashboard, backed by its own admin_user /
# admin_session tables — never the removed end-user account model. The first
# time the backend starts with no admin account yet, both variables below
# create exactly one administrator; leaving either blank skips bootstrap
# safely (no admin is created, and /admin login then fails until they are set
# and the backend restarts). They are never read again once that first admin
# account exists, and only the BCrypt hash of the password is ever stored.
# NEVER put real values in this checked-in example file — set them only in a
# real untracked `backend/.env`, your IDE run configuration, or your secret manager.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
# Admin login session lifetime.
ADMIN_SESSION_TTL=30m

# ---------- AI explanation (optional, disabled by default) ----------
# Leave AI_EXPLANATIONS_ENABLED unset/false to keep the feature off — the two
# DeepSeek values below are then not read. Setting it to true without a real
# key and model fails startup with a clear configuration error; it does not
# silently disable the feature. Get a key at https://platform.deepseek.com/.
# DEEPSEEK_MODEL has no hard-coded default — name a real DeepSeek model id
# explicitly (see https://api-docs.deepseek.com/quick_start/pricing-details-cny/
# for the current model list).
# NEVER put a real key in this checked-in example file — set it only in a real
# untracked `backend/.env`, your IDE run configuration, or your secret manager.
AI_EXPLANATIONS_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

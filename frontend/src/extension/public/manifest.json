{
  "manifest_version": 3,
  "name": "LinkSentry Scanner",
  "version": "0.3.0",
  "description": "Scans the current tab or a right-clicked link for lexical phishing risk signals with the LinkSentry API. Never visits the link.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scan this tab with LinkSentry",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "contextMenus", "storage"],
  "host_permissions": ["https://linksentry-web.onrender.com/*"]
}

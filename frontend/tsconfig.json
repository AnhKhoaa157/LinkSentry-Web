{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    /* Vite handles emit; tsc is used purely as a type checker. */
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    /* Strictness. Worth the friction: these are the checks that catch a
       mis-parsed API response before it becomes a blank screen. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "erasableSyntaxOnly": true,

    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom", "chrome"],

    /* No `baseUrl`: it is deprecated in TypeScript 6 and removed in 7. Path
       mappings resolve relative to this file instead. Mirrored in vite.config.ts. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "eslint.config.js"]
}

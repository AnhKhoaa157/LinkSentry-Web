# LinkSentry frontend — example environment file.
#
# Copy to `frontend/.env.local` for local development:
#   cp .env.example .env.local
#
# Only variables prefixed with VITE_ are exposed to the browser bundle. Never put
# a secret here: everything in this file ships to the client in plain text.

# Base URL of the LinkSentry API. No trailing slash.
#
# Also the base URL the extension popup (`npm run build:extension`) is built
# against — for a fully local extension loop, keep this in sync with the
# `host_permissions` entry in `src/extension/public/manifest.json` (see the
# root README's "Browser extension" section).
VITE_API_BASE_URL=http://localhost:8080

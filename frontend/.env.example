# LinkSentry frontend — example environment file.
#
# Copy to `frontend/.env.local` for local development:
#   cp .env.example .env.local
#
# Only variables prefixed with VITE_ are exposed to the browser bundle. Never put
# a secret here: everything in this file ships to the client in plain text.

# Base URL of the LinkSentry API. No trailing slash.
VITE_API_BASE_URL=http://localhost:8080
